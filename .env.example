# =====================================================================
# AI Revenue Recovery Orchestrator — Environment Configuration
# =====================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Gemini AI (Server-Side LLM for Bounded Diagnosis & Summarization)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Razorpay Test Mode Credentials
# Get keys from: Razorpay Dashboard > Settings > API Keys (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PostgreSQL Database Connection
# Leave empty to use SQLite fallback for local development.
# Production/demo: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=

# Demonstration Policy Defaults (Configurable Demo Policies)
# NOTE: These are demonstration values for the buildathon, not universal regulatory mandates.
DEFAULT_MAX_RETRIES=3
DEFAULT_RETRY_COOLDOWN_HOURS=4
DEFAULT_AUTOMATED_AMOUNT_LIMIT=15000
